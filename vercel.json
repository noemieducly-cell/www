{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/project/:slug", "destination": "/project.html" }
  ],
  "redirects": [
    {
      "source": "/project.html",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>[^&]+)" }],
      "destination": "/project/:slug",
      "permanent": true
    },
    {
      "source": "/project",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>[^&]+)" }],
      "destination": "/project/:slug",
      "permanent": true
    }
  ]
}
